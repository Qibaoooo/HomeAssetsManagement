# Copy to .env to override defaults. All values optional.

# Where the server listens. 0.0.0.0 exposes it on the LAN.
HOST=0.0.0.0
PORT=8787

# Google Sheet to sync with (spreadsheet id from the URL) and the tab name.
SHEET_ID=1tEzE0h4k8TVHYLXmiyBs-3Hsq20Lygv5QNrE0Z_9IH4
SHEET_TAB=HomeAssets

# Service account JSON key, relative to the repo root. Share the sheet with its client_email as Editor.
GOOGLE_KEY_FILE=secrets/service-account.json

# SQLite database + photos live here (git-ignored).
DATA_DIR=data

# How often to pull hand edits from the sheet, in minutes.
SYNC_INTERVAL_MIN=1

# Google Drive backup (optional). OAuth "Desktop app" client JSON + token written by `npm run drive-auth`.
GOOGLE_OAUTH_CLIENT=secrets/oauth-client.json
GOOGLE_DRIVE_TOKEN=secrets/drive-token.json
# Folder created in the Drive root; photos go in a "photos" subfolder.
BACKUP_FOLDER=HomeAssets Backup
# How often to back up. 0 disables the scheduler (manual `npm run backup` still works).
BACKUP_INTERVAL_HOURS=1
