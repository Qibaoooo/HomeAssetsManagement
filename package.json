{
  "name": "home-assets",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "sync": "npm run sync -w server",
    "drive-auth": "npm run drive-auth -w server",
    "backup": "npm run backup -w server",
    "restore": "npm run restore -w server",
    "start:test": "node --env-file=.env.test server/dist/index.js",
    "test:seed": "node scripts/seed-test.mjs",
    "test": "npm test -w server",
    "mock:sheets": "npm run mock:sheets -w server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
